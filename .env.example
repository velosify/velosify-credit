# ---- Core -----------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_BASE_URL=https://velosifycredit.com
FLASK_DEBUG=0

# ---- Brand ----------------------------------------------------------------
BRAND_NAME=VelosifyCredit
BRAND_DOMAIN=velosifycredit.com
SUPPORT_EMAIL=support@velosifycredit.com
SUPPORT_PHONE=(602) 772-8020
COMPANY_LEGAL_NAME=VelosifyCredit LLC
COMPANY_ADDRESS=901 Tower Dr, Suite 250, Troy, MI 48098

# ---- Storage --------------------------------------------------------------
# THE MOST IMPORTANT LINE IN THIS FILE.
#
# Point DATA_DIR at a mounted volume. The database and the uploaded documents
# both follow it. Leave it unset in production and they are written inside the
# application directory, which the host rebuilds on every deploy: every
# client, document and message is erased, with no error and nothing to
# restore from. The app now refuses to be quiet about this — it says so at
# boot and on every admin page — but the fix is here.
DATA_DIR=/data
# Only needed if the two must live apart. DATA_DIR covers both.
# DB_PATH=/data/velosify_credit.db
# UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# ---- Pricing --------------------------------------------------------------
PRICE_CENTS=99700
CURRENCY=usd

# ---- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set after creating the endpoint at /webhook/stripe in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# Optional: use a Price object instead of an inline amount
STRIPE_PRICE_ID=

# Leave at 0 in production. With no Stripe keys the app simulates checkout.
DEV_FAKE_CHECKOUT=0

# ---- Email ----------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=VelosifyCredit <no-reply@velosifycredit.com>
ADMIN_ALERT_EMAIL=

# ---- First admin account --------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Compliance -----------------------------------------------------------
CANCELLATION_DAYS=3

# State registrations published on /legal/state-disclosures. JSON array; the
# page says "still registering" while this is empty rather than implying
# coverage that does not exist.
# STATE_REGISTRATIONS=[{"state":"Texas","registration":"CSO #12345","bond":"$10,000"}]

# ---- Observability --------------------------------------------------------
# Both optional. Without a DSN the app logs to stdout exactly as before.
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Backups --------------------------------------------------------------
# Where `python backup.py` writes archives. On Railway point this at the
# mounted volume, or better, at somewhere off the box entirely.
BACKUP_DIR=backups
