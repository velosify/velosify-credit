# ---- Core -----------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_BASE_URL=https://velosifycredit.com
FLASK_DEBUG=0

# ---- Brand ----------------------------------------------------------------
BRAND_NAME=VelosifyCredit
BRAND_DOMAIN=velosifycredit.com
SUPPORT_EMAIL=support@velosifycredit.com
SUPPORT_PHONE=
COMPANY_LEGAL_NAME=VelosifyCredit LLC
COMPANY_ADDRESS=

# ---- Storage --------------------------------------------------------------
# On Railway, point both at a mounted volume so they survive redeploys.
DB_PATH=/data/velosify_credit.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# ---- Pricing --------------------------------------------------------------
PRICE_CENTS=99700
CURRENCY=usd

# ---- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set after creating the endpoint at /webhook/stripe in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# Optional: use a Price object instead of an inline amount
STRIPE_PRICE_ID=

# Leave at 0 in production. With no Stripe keys the app simulates checkout.
DEV_FAKE_CHECKOUT=0

# ---- Email ----------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=VelosifyCredit <no-reply@velosifycredit.com>
ADMIN_ALERT_EMAIL=

# ---- First admin account --------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Compliance -----------------------------------------------------------
CANCELLATION_DAYS=3
